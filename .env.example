# PostgreSQL: pooled URL for runtime + direct/session URL for Prisma operations.
# Replace credentials/host with your local Postgres or Supabase project values.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cinevood?schema=cinemood"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cinevood?schema=cinemood"

AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""

# Google OAuth — optional for local browsing; required to enable Google sign-in.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional external metadata and trailer integrations; keys stay server-side.
TMDB_API_KEY=""
OMDB_API_KEY=""
YOUTUBE_API_KEY="" # optional wider trailer search after TMDB-linked videos

# Private FastAPI IMDbio service deployed from imdbio-service/ on Render.
# Use the service URL without a trailing slash and the same generated token on both services.
IMDBIO_API_URL=""
IMDBIO_API_TOKEN=""

# Optional server-side Google AI Studio key for Jarvis Q&A, cached public reviews, consent-gated drafts, and translations.
GEMINI_API_KEY=""
