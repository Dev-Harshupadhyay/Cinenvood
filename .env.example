# ═══ CINE-MOOD AI — Environment Variables ═══
# Render dashboard → Environment mein ye set karo (local ke liye .env file banao)

# 🔑 Gemini AI key (REQUIRED for AI reviews)
# Google AI Studio se naya key lo: https://aistudio.google.com/apikey
# ⚠️ Key ko kabhi code/commit mein mat daalna — Google leak detect karke block kar deta hai
GEMINI_API_KEY=your_new_gemini_key_here

# Gemini model (default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# TMDB API key (Render pe already set hai)
TMDB_API_KEY=your_tmdb_key

# Supabase — URL + anon key browser auth config ke liye, service role sirf server par
SUPABASE_URL=https://your-project-ref.supabase.co
# New Supabase key names (recommended)
SUPABASE_PUBLISHABLE_KEY=your_sb_publishable_key
SUPABASE_SECRET_KEY=your_sb_secret_key
# Legacy aliases are also supported (optional)
SUPABASE_ANON_KEY=your_legacy_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key
SUPABASE_KEY=your_legacy_anon_key

# Admin panel
ADMIN_PASSWORD=your_admin_password
# Long random secrets — password se different rakho
ADMIN_SESSION_SECRET=generate_a_long_random_64_character_secret
ANALYTICS_SALT=generate_another_long_random_64_character_secret
