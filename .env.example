# ═══ CINE-MOOD AI — Environment Variables ═══
# Render dashboard → Environment mein ye set karo (local ke liye .env file banao)

# 🔑 Gemini AI key (REQUIRED for AI reviews)
# Google AI Studio se naya key lo: https://aistudio.google.com/apikey
# ⚠️ Key ko kabhi code/commit mein mat daalna — Google leak detect karke block kar deta hai
GEMINI_API_KEY=your_new_gemini_key_here

# Gemini model (default: gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# TMDB API key (Render pe already set hai)
TMDB_API_KEY=your_tmdb_key

# Supabase (Render pe already set hai)
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key

# Admin panel password (Render pe already set hai)
ADMIN_PASSWORD=your_admin_password
